<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS and WWW canonical host
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^jonoblackburn\.com [NC]
  RewriteRule ^(.*)$ https://www.jonoblackburn.com/$1 [L,R=301,NE]

  # Legacy indexed routes -> homepage anchors
  RewriteRule ^jono/?$ /#founder [L,R=301,NE]
  RewriteRule ^about/?$ /#founder [L,R=301,NE]
  RewriteRule ^imed/?$ /#products [L,R=301,NE]
  RewriteRule ^current-projects/?$ /#products [L,R=301,NE]
  RewriteRule ^current-projects-mobile/?$ /#products [L,R=301,NE]
  RewriteRule ^special-projects/?$ /#products [L,R=301,NE]
  RewriteRule ^special-projects-mobile/?$ /#products [L,R=301,NE]
  RewriteRule ^seed2shelf/?$ /#products [L,R=301,NE]
  RewriteRule ^seed2shelf-mobile/?$ /#products [L,R=301,NE]

  # Contact page: redirect /contact to /contact/ so Apache serves the directory index
  RewriteRule ^contact$ /contact/ [L,R=301]

  # SPA fallback (React Router) — only for non-file, non-directory requests
  # Exclude /contact/ so the standalone contact page is served directly
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/contact/
  RewriteRule . /index.html [L]
</IfModule>

# Text compression (JS bundle 788 KB -> ~227 KB over the wire)
# Note: this Apache maps .js to text/javascript (RFC 9239), so both MIME types are listed.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# HTML shells must always revalidate so visitors never run a stale bundle
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Long-lived caching for hashed build assets and media
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(js|css|woff2?)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType video/mp4 "access plus 6 months"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>
